# Banco
DATABASE_URL="postgresql://voacraque:voacraque@localhost:55432/voacraque?schema=public"
VOACRAQUE_DB_USER=voacraque
VOACRAQUE_DB_PASSWORD=voacraque
VOACRAQUE_DB_NAME=voacraque
VOACRAQUE_DB_PORT=55432
VOACRAQUE_APP_PORT=3000

# Auth.js v5 - gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Superadmin criado pelo seed
SUPERADMIN_EMAIL="super@voacraque.app"
SUPERADMIN_PASSWORD="VoaCraque123!"
SUPERADMIN_NAME="Superadmin"

# Dados de exemplo no seed (admin + 20 jogadores)
SEED_SAMPLE_DATA=true

# Armazenamento de arquivos: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Usados apenas quando STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
