# Banco
DATABASE_URL="postgresql://voacraque:voacraque@localhost:55432/voacraque?schema=public"
VOACRAQUE_DB_USER=voacraque
VOACRAQUE_DB_PASSWORD=voacraque
VOACRAQUE_DB_NAME=voacraque
VOACRAQUE_DB_PORT=55432
VOACRAQUE_APP_PORT=3000

# Sessao (JWT de 15 min + refresh token de 7 dias). Segredo que assina o cookie de
# sessao e o state do login com o Google: minimo 32 caracteres.
# Gere com: openssl rand -base64 32
# Para trocar sem derrubar sessoes, mova o antigo para AUTH_SECRET_1 e ponha o
# novo aqui. Quem tem este valor assina sessao de qualquer usuario: nunca commite.
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"
# URL publica da aplicacao. Define o Secure dos cookies (https), o redirect URI
# do login com o Google e o link do e-mail de redefinicao de senha.
AUTH_URL="http://localhost:3000"

# Login com Google (opcional). Sem as duas variaveis, o botao do Google nao aparece.
# 1. https://console.cloud.google.com/apis/credentials > Criar credenciais >
#    ID do cliente OAuth > Aplicativo da Web
# 2. Origens JavaScript autorizadas:   http://localhost:3000
# 3. URIs de redirecionamento:         http://localhost:3000/api/auth/callback/google
#    (em producao, as mesmas duas com o dominio publico, em https)
# 4. Tela de consentimento OAuth: escopos openid, email e profile bastam.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Quantos proxies confiaveis ficam na frente da aplicacao (nginx, ALB, Cloudflare).
# Define de qual posicao do X-Forwarded-For sai o IP usado no rate limit e na auditoria.
TRUST_PROXY_HOPS=1

# Superadmin criado pelo seed
SUPERADMIN_EMAIL="super@voacraque.app"
SUPERADMIN_PASSWORD="VoaCraque123!"
SUPERADMIN_NAME="Superadmin"
# Sem isto, o username sai do que vem antes do @ em SUPERADMIN_EMAIL.
SUPERADMIN_USERNAME="super"

# Dados de exemplo no seed (admin + 20 jogadores)
SEED_SAMPLE_DATA=true

# Armazenamento de arquivos: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Limite do comprovante de pagamento (gravado como veio).
MAX_UPLOAD_MB=5
# Limite da foto de perfil: ela e reduzida no servidor para WebP 512x512 (~40 KB),
# entao aceita o arquivo cru da camera. O proxy do Next corta o corpo em 10 MB por
# padrao; next.config.ts sobe para 25 MB, entao nao passe de ~24 MB aqui.
MAX_PHOTO_UPLOAD_MB=20

# Usados apenas quando STORAGE_DRIVER=s3. O bucket deve ficar privado (sem
# acesso publico): os arquivos sao sempre servidos via /api/files, que confere
# a sessao e devolve uma URL assinada de 60s. Rodando em uma EC2 com IAM role
# com permissao no bucket, deixe S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY em
# branco — o SDK usa as credenciais da role automaticamente.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail (recuperacao de senha e avisos de seguranca).
# console: so imprime a mensagem no log do servidor (desenvolvimento).
# smtp:    envia de verdade pelo servidor abaixo.
MAIL_DRIVER=console
MAIL_FROM="Voa Craque <nao-responda@voacraque.app>"
SMTP_HOST=
SMTP_PORT=587
# true para a porta 465 (TLS direto); false para 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
