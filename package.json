{
  "name": "voacraque",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "test": "jest",
    "test:unit": "jest --selectProjects unit component",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage && node scripts/check-coverage.mjs",
    "test:ci": "jest --ci --coverage --maxWorkers=50% && node scripts/check-coverage.mjs",
    "test:db:up": "docker compose -f docker-compose.dev.yml up -d --wait db-test",
    "test:db:down": "docker compose -f docker-compose.dev.yml rm -sf db-test",
    "e2e:up": "node scripts/with-env.mjs .env.e2e -- docker compose -f docker-compose.e2e.yml up -d --build --wait --wait-timeout 240",
    "e2e:down": "node scripts/with-env.mjs .env.e2e -- docker compose -f docker-compose.e2e.yml down -v --remove-orphans",
    "e2e:logs": "node scripts/with-env.mjs .env.e2e -- docker compose -f docker-compose.e2e.yml logs --no-color app",
    "cy:open": "cypress open",
    "cy:run": "cypress run --e2e",
    "cy:component": "cypress run --component",
    "test:e2e": "node scripts/e2e.mjs",
    "test:watch": "jest --watch --selectProjects unit component",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:pelada-teste": "tsx prisma/seed-pelada-teste.ts",
    "db:seed:piloto": "tsx prisma/seed-piloto.ts",
    "db:seed:ranking-mmr": "tsx prisma/seed-ranking-mmr.ts",
    "db:purge-tokens": "tsx scripts/purge-tokens.ts",
    "mmr:recompute": "tsx scripts/recompute-mmr.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.926.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "nodemailer": "^8.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cypress": "^16.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
