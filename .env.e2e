# Variaveis do E2E (Cypress contra `next build` + `next start -p 3100`). Sem segredo: so teste.
# Nao herda o .env: S3, SMTP e Google ficam vazios e o banco e o voacraque_e2e do db-test.
# Variavel ja definida no ambiente (o CI) tem precedencia sobre este arquivo.
DATABASE_URL="postgresql://voacraque:voacraque@localhost:55433/voacraque_e2e?schema=public"
AUTH_SECRET="segredo-so-para-e2e-com-mais-de-32-caracteres"
AUTH_URL="http://localhost:3100"
STORAGE_DRIVER=local
UPLOAD_DIR=./.e2e-uploads
MAIL_DRIVER=console
MAX_UPLOAD_MB=5
MAX_PHOTO_UPLOAD_MB=20
TRUST_PROXY_HOPS=1
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
