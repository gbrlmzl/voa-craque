# Variaveis do E2E: Cypress no host contra a imagem do deploy (docker-compose.e2e.yml, app em :3100).
# Sem segredo: so teste. Carregado por scripts/with-env.mjs (compose) e por `tsx --env-file` (tasks);
# o container recebe as chaves do proprio compose, nunca este arquivo nem o .env.
# DATABASE_URL e a visao do HOST (porta publicada do db do compose); dentro do container e db:5432.
# Variavel ja definida no ambiente (o CI) tem precedencia sobre este arquivo.
DATABASE_URL="postgresql://voacraque:voacraque@localhost:55434/voacraque_e2e?schema=public"
AUTH_SECRET="segredo-so-para-e2e-com-mais-de-32-caracteres"
AUTH_URL="http://localhost:3100"
STORAGE_DRIVER=local
MAIL_DRIVER=console
MAX_UPLOAD_MB=5
MAX_PHOTO_UPLOAD_MB=20
TRUST_PROXY_HOPS=1
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPERADMIN_EMAIL=super@voacraque.test
SUPERADMIN_PASSWORD=SenhaSuperE2E123!
